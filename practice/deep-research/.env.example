# Copy this file to .env for local development. Fill secrets only in .env.
# Never commit, print, log, trace, or share real credentials.

# The Google GenAI SDK reads GOOGLE_API_KEY (or GEMINI_API_KEY) from the environment.
# Google Gemini is the primary provider for the standard tier, the fallback for the reasoning
# tier, and the default embeddings provider.
GOOGLE_API_KEY=
# The Groq SDK reads GROQ_API_KEY from the environment. Groq is the primary provider for the
# reasoning tier and the fallback for the standard tier.
GROQ_API_KEY=
# The OpenAI SDK reads OPENAI_API_KEY from the environment. Required by the RAGAS Faithfulness
# judge, the third report-verification gate (see INTELLIGENCE_FAITHFULNESS_MODEL below): without
# it every verification ends in ERROR and no report can be approved. Also usable for opt-in
# model/embedding overrides.
OPENAI_API_KEY=

# Opt-in live smoke tests (tests/integration/test_scope_live_smoke.py,
# test_live_mcp_opt_in.py) reuse INTELLIGENCE_REASONING_MODEL/_PROVIDER below — there is no
# separate model config for them.
RUN_LIVE_LLM=0

# Required for live application executions. Offline fake-model tests do not need credentials.
INTELLIGENCE_LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region where the API key pair was created:
# EU=https://cloud.langfuse.com, US=https://us.cloud.langfuse.com,
# Japan=https://jp.cloud.langfuse.com, HIPAA=https://hipaa.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=local

# Local application storage. These values are not credentials.
INTELLIGENCE_VFS_ROOT=.data/vfs
INTELLIGENCE_CHECKPOINT_PATH=.data/checkpoints.sqlite3
INTELLIGENCE_RUN_REGISTRY_PATH=.data/run_registry.sqlite3
INTELLIGENCE_OUTPUT_DIR=exports

# Chroma vector store for evidence retrieval (used by the Build/Fix report writer). Embeddings
# are computed with GOOGLE_API_KEY above by default; Chroma itself is local, no separate
# service required. Set INTELLIGENCE_EMBEDDING_PROVIDER=openai (with an OpenAI model name) to
# switch back to OpenAI embeddings.
INTELLIGENCE_CHROMA_PATH=.data/chroma
INTELLIGENCE_EMBEDDING_MODEL=gemini-embedding-2
INTELLIGENCE_EMBEDDING_PROVIDER=google_genai
# Max sources per research question shown to the report writer when that question's stored
# excerpts exceed 12,000 characters (smaller evidence is read directly, without Chroma).
# Verification always checks the full evidence.
INTELLIGENCE_EVIDENCE_TOP_K=3
# Distinct pages one searcher ACCEPTS for its task, counted across ALL of its searches (not per
# search); rejected results never use a slot. Default 5, max 10.
INTELLIGENCE_MAX_SOURCES_PER_TASK=5
INTELLIGENCE_MAX_SEARCH_CALLS=2
INTELLIGENCE_RECOVERY_ATTEMPTS=1
# Passages one stored-passage lookup returns (hybrid meaning + keyword ranking). Default 5, 1-20.
INTELLIGENCE_LOOKUP_TOP_K=5
# Follow-up research tasks the supervisor may create for essential gaps: per run (default 4, 0-8)
# and per required answer of the brief (default 2, 0-4).
INTELLIGENCE_MAX_FOLLOW_UPS_PER_RUN=4
INTELLIGENCE_MAX_FOLLOW_UPS_PER_ANSWER=2
# Word limit of a searcher's short report to the supervisor. Default 400, 100-1000.
INTELLIGENCE_REPORT_MAX_WORDS=400

# RAGAS Faithfulness judge: the third verification gate (score must be strictly greater than
# 0.90). Independent of the reasoning/standard tier models above. Defaults to OpenAI
# gpt-4.1-mini; provider is "openai" or "google_genai". When that provider's key
# (OPENAI_API_KEY / GOOGLE_API_KEY) is unset, verification reports ERROR.
INTELLIGENCE_FAITHFULNESS_MODEL=gpt-4.1-mini
INTELLIGENCE_FAITHFULNESS_PROVIDER=openai
# Optional RAGAS observations of the passing report (comma-separated; empty disables them):
# context_precision (per research question, on the writer's ranked evidence),
# response_relevancy (report vs. research brief; uses INTELLIGENCE_EMBEDDING_* embeddings).
# Faithfulness always runs as a verification gate, whatever this lists.
INTELLIGENCE_EVAL_METRICS=
INTELLIGENCE_QUALITY_OUTPUT_TOKENS=2048

# Output caps per model call, including fallback and retry calls. Pure graph nodes use no tokens.
# These are NOT a guaranteed $0.02 run budget: input, embeddings and search also cost money.
INTELLIGENCE_NODE_OUTPUT_TOKENS={"guardrail":128,"scope":1536,"planner":1024,"researcher":512,"result_evaluator":1024,"query_rewriter":512,"searcher_report":1536,"claim_judge":3072,"synthesizer":2048,"fixer":768,"verify":3072,"feedback_router":256}
INTELLIGENCE_MODEL_MAX_ATTEMPTS=1

# Optional live Tavily MCP acceptance test. Keep the API key only in your local .env.
RUN_LIVE_MCP=0
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=

# Semantic-role model routing (drives the whole live app; see app.py::_get_role_router).
# "Reasoning Sandwich" baseline: a high-reasoning-effort model plans (scope, planner) and
# verifies (verify — the LLM acceptance-criteria check) around standard-tier implementation work
# (researcher, result_evaluator, query_rewriter, searcher_report, synthesizer, fixer).
#
# Groq (gpt-oss) is the primary provider for the reasoning tier and Google Gemini for the
# standard tier; each tier falls back to the other provider (only used if the primary call
# fails). Leave a *_FALLBACK_MODEL blank to run that profile with only its primary model.
#
# *_KWARGS (JSON object) are passed straight through to the PRIMARY model's SDK via
# init_chat_model, unvalidated. The fallback model always runs without them. Rules:
# - reasoning_effort is only accepted by reasoning models (OpenAI gpt-5*/o-series, Gemini
#   2.5+/3.x, Groq gpt-oss). Sending it to a non-reasoning model (e.g. gpt-4.1, gpt-4o) fails
#   every call with 400 "Unrecognized request argument supplied: reasoning_effort" — use {} there.
# - Valid values are "minimal"/"low"/"medium"/"high"; "high" is the ceiling (neither ChatOpenAI
#   nor ChatGoogleGenerativeAI supports "xhigh").
# - Setting a value replaces the built-in reasoning-tier default
#   ({"reasoning_effort":"high","max_tokens":8000}) entirely. With "high" effort keep a max_tokens
#   cap, or the hidden reasoning trace can use the whole budget and return an empty answer.
#
# Reasoning tier: low effort for the low-cost profile. Role output caps below the
# tier ceiling apply to both providers. A configured fallback still adds a paid call;
# leave fallback model names empty for primary-only execution.
INTELLIGENCE_REASONING_MODEL=openai/gpt-oss-120b
INTELLIGENCE_REASONING_PROVIDER=groq
INTELLIGENCE_REASONING_KWARGS={"reasoning_effort":"low","max_tokens":4096}
INTELLIGENCE_REASONING_FALLBACK_MODEL=gemini-3.8-flash
INTELLIGENCE_REASONING_FALLBACK_PROVIDER=google_genai
# Standard tier (researcher, result evaluator, query rewriter, searcher report, synthesizer,
# fixer, scope guardrail). The tier is meant
# to be cheap/fast, not deep reasoning, so keep effort low here.
INTELLIGENCE_STANDARD_MODEL=gemini-3.5-flash-lite
INTELLIGENCE_STANDARD_PROVIDER=google_genai
INTELLIGENCE_STANDARD_KWARGS={"reasoning_effort":"low"}
INTELLIGENCE_STANDARD_FALLBACK_MODEL=openai/gpt-oss-20b
INTELLIGENCE_STANDARD_FALLBACK_PROVIDER=groq

INTELLIGENCE_REASONING_TIMEOUT=120
INTELLIGENCE_STANDARD_TIMEOUT=60
