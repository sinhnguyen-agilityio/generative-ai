# Copy to .env and fill in secrets there only. Never commit real credentials.

# Provider keys (read by the provider SDKs)
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Reasoning sandwich: plan/supervise (medium) -> research/write (low) -> verify (medium).
# Both tiers use GPT-5.4 nano; their reasoning effort differs by responsibility.
# Reasoning tier: clarify, brief, planner, supervisor, triage, verifier.
# Standard tier: guardrail, researchers, topic reports, report writer.
# The RAGAS evaluator uses the separate Gemini judge configured below.
# *_KWARGS configure the primary; *_FALLBACK_KWARGS configure the fallback independently.
# OpenAI uses Responses API for tool calling with reasoning enabled.
# Leave a *_FALLBACK_MODEL empty to run that tier without a fallback.
INTELLIGENCE_REASONING_MODEL=gpt-5.4-nano
INTELLIGENCE_REASONING_PROVIDER=openai
INTELLIGENCE_REASONING_KWARGS={"reasoning_effort":"medium","use_responses_api":true}
INTELLIGENCE_REASONING_FALLBACK_MODEL=openai/gpt-oss-120b
INTELLIGENCE_REASONING_FALLBACK_PROVIDER=groq
INTELLIGENCE_REASONING_FALLBACK_KWARGS={"reasoning_effort":"medium"}
INTELLIGENCE_REASONING_TIMEOUT=120
INTELLIGENCE_STANDARD_MODEL=gpt-5.4-nano
INTELLIGENCE_STANDARD_PROVIDER=openai
INTELLIGENCE_STANDARD_KWARGS={"reasoning_effort":"low","use_responses_api":true}
INTELLIGENCE_STANDARD_FALLBACK_MODEL=openai/gpt-oss-120b
INTELLIGENCE_STANDARD_FALLBACK_PROVIDER=groq
INTELLIGENCE_STANDARD_FALLBACK_KWARGS={"reasoning_effort":"low"}
INTELLIGENCE_STANDARD_TIMEOUT=60

# Web search through Tavily's MCP server
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=

# Prompt guidance, not hard runtime limits: parallel researchers and searches per researcher.
INTELLIGENCE_MAX_CONCURRENT_RESEARCHERS=3
INTELLIGENCE_MAX_SEARCH_CALLS=5

# Result pages are cleaned, chunked, embedded and stored in a local Chroma collection; each search
# shows the researcher the passages most relevant to its query
INTELLIGENCE_RETRIEVAL_K=6

INTELLIGENCE_CHROMA_PATH=.data/chroma
INTELLIGENCE_EMBEDDING_MODEL=gemini-embedding-2
INTELLIGENCE_EMBEDDING_PROVIDER=google_genai

# RAGAS judge for the final report: a Gemini model through google-genai (uses GOOGLE_API_KEY),
# apart from the research tiers so the models that write the report do not grade it
INTELLIGENCE_EVALUATION_MODEL=gemini-flash-latest

# Thread checkpoints (resume after review or after a crash) and published reports
INTELLIGENCE_CHECKPOINT_PATH=.data/checkpoints.sqlite3
INTELLIGENCE_OUTPUT_DIR=exports

# Langfuse tracing: one trace per research thread, evaluation scores attached
INTELLIGENCE_LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
