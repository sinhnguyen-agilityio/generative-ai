# Copy this file to .env for local development. Fill secrets only in .env.
# Never commit, print, log, trace, or share real credentials.

# The Google GenAI SDK reads GOOGLE_API_KEY (or GEMINI_API_KEY) from the environment.
GOOGLE_API_KEY=
# The OpenAI SDK reads OPENAI_API_KEY from the environment.
OPENAI_API_KEY=

# Only used by the opt-in live smoke tests below (tests/integration/test_scope_live_smoke.py,
# test_live_mcp_opt_in.py) — the live app itself is driven entirely by the
# INTELLIGENCE_REASONING_*/INTELLIGENCE_STANDARD_* settings further down.
SCOPE_MODEL=gemini-2.5-flash
SCOPE_PROVIDER=google_genai
SCOPE_FALLBACK_MODEL=gpt-5.4
SCOPE_FALLBACK_PROVIDER=openai
RUN_LIVE_LLM=0

# Required for live application executions. Offline fake-model tests do not need credentials.
INTELLIGENCE_LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region where the API key pair was created:
# EU=https://cloud.langfuse.com, US=https://us.cloud.langfuse.com,
# Japan=https://jp.cloud.langfuse.com, HIPAA=https://hipaa.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=local

# Local application storage. These values are not credentials.
INTELLIGENCE_VFS_ROOT=.data/vfs
INTELLIGENCE_CHECKPOINT_PATH=.data/checkpoints.sqlite3
INTELLIGENCE_VECTOR_PATH=.data/vector-index.json
INTELLIGENCE_OUTPUT_DIR=exports

# Chroma vector store for evidence retrieval (used by the Build/Fix report writer). Embeddings
# are computed with OPENAI_API_KEY above; Chroma itself is local, no separate service required.
INTELLIGENCE_CHROMA_PATH=.data/chroma
INTELLIGENCE_EMBEDDING_MODEL=text-embedding-3-small
# Max sources per research question shown to the report writer (full evidence is still what
# the source-verification script checks against; this only narrows the Build/Fix prompt).
INTELLIGENCE_EVIDENCE_TOP_K=6
MCP_SERVER_CONFIG=

# Optional live Tavily MCP acceptance test. Keep the API key only in your local .env.
RUN_LIVE_MCP=0
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=

# Semantic-role model routing (drives the whole live app; see app.py::_get_role_router).
# Reasoning profile (xhigh tier): scope, planner, and verify (the LLM acceptance-criteria check).
# Standard profile: researcher, research_compressor, synthesizer, and fixer.
# GPT is the reasoning tier here because Gemini has no free "xhigh"-equivalent tier (Pro is
# paid-only; Flash's ceiling is thinking_level "high"). Gemini is the standard tier — cheap/free,
# used for the high-volume research and drafting calls. Leave a *_FALLBACK_MODEL blank to run
# that profile with only its primary model.
INTELLIGENCE_REASONING_MODEL=gpt-5.4
INTELLIGENCE_REASONING_PROVIDER=openai
INTELLIGENCE_REASONING_KWARGS={"reasoning_effort":"xhigh"}
INTELLIGENCE_REASONING_FALLBACK_MODEL=
INTELLIGENCE_REASONING_FALLBACK_PROVIDER=
INTELLIGENCE_STANDARD_MODEL=gemini-2.5-flash
INTELLIGENCE_STANDARD_PROVIDER=google_genai
# Gemini Flash defaults to thinking_level "high"; set it low here since this tier is meant to be
# cheap/fast, not because Gemini "can't" reason deeply.
INTELLIGENCE_STANDARD_KWARGS={"reasoning_effort":"low"}
INTELLIGENCE_STANDARD_FALLBACK_MODEL=gpt-5.4
INTELLIGENCE_STANDARD_FALLBACK_PROVIDER=openai
