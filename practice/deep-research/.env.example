# Copy to .env and fill in secrets there only. Never commit real credentials.

# Provider keys (read by the provider SDKs)
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Models. Reasoning tier: clarify, brief, planner, supervisor, evaluator.
# Standard tier: guardrail, researchers, topic reports, report writer.
# *_KWARGS are passed to init_chat_model for the primary model only; fallbacks run with defaults.
# Leave a *_FALLBACK_MODEL empty to run that tier without a fallback.
INTELLIGENCE_REASONING_MODEL=openai/gpt-oss-120b
INTELLIGENCE_REASONING_PROVIDER=groq
INTELLIGENCE_REASONING_KWARGS={"reasoning_effort":"low","max_tokens":4096}
INTELLIGENCE_REASONING_FALLBACK_MODEL=
INTELLIGENCE_REASONING_FALLBACK_PROVIDER=
INTELLIGENCE_REASONING_TIMEOUT=120
INTELLIGENCE_STANDARD_MODEL=gemini-3.5-flash-lite
INTELLIGENCE_STANDARD_PROVIDER=google_genai
INTELLIGENCE_STANDARD_KWARGS={"reasoning_effort":"low"}
INTELLIGENCE_STANDARD_FALLBACK_MODEL=
INTELLIGENCE_STANDARD_FALLBACK_PROVIDER=
INTELLIGENCE_STANDARD_TIMEOUT=60

# Web search through Tavily's MCP server
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=

# Research limits: researchers running in parallel, and web searches per researcher
INTELLIGENCE_MAX_CONCURRENT_RESEARCHERS=3
INTELLIGENCE_MAX_SEARCH_CALLS=5

# Result pages are cleaned, chunked, embedded and stored in a local Chroma collection; each search
# shows the researcher the passages most relevant to its query
INTELLIGENCE_RETRIEVAL_K=6

INTELLIGENCE_CHROMA_PATH=.data/chroma
INTELLIGENCE_EMBEDDING_MODEL=gemini-embedding-2
INTELLIGENCE_EMBEDDING_PROVIDER=google_genai

# Thread checkpoints (resume after review or after a crash) and published reports
INTELLIGENCE_CHECKPOINT_PATH=.data/checkpoints.sqlite3
INTELLIGENCE_OUTPUT_DIR=exports

# Langfuse tracing: one trace per research thread, evaluation scores attached
INTELLIGENCE_LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
