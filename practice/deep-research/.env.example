# Copy this file to .env for local development. Fill secrets only in .env.
# Never commit, print, log, trace, or share real credentials.

# The Google GenAI SDK reads GOOGLE_API_KEY (or GEMINI_API_KEY) from the environment.
# Google Gemini is the primary provider for this app (reasoning tier, standard tier, and
# embeddings all default to it), and is also required to enable the RAGAS Faithfulness judge
# (observability only, see INTELLIGENCE_FAITHFULNESS_MODEL below) — that judge is disabled
# entirely when this is unset.
GOOGLE_API_KEY=
# The Groq SDK reads GROQ_API_KEY from the environment. Groq is the secondary/fallback
# provider for the reasoning/standard tiers, used only when the primary Gemini call fails.
GROQ_API_KEY=
# The OpenAI SDK reads OPENAI_API_KEY from the environment. Not used by default, kept for
# opt-in model/embedding overrides.
OPENAI_API_KEY=

# Opt-in live smoke tests (tests/integration/test_scope_live_smoke.py,
# test_live_mcp_opt_in.py) reuse INTELLIGENCE_REASONING_MODEL/_PROVIDER below — there is no
# separate model config for them.
RUN_LIVE_LLM=0

# Required for live application executions. Offline fake-model tests do not need credentials.
INTELLIGENCE_LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region where the API key pair was created:
# EU=https://cloud.langfuse.com, US=https://us.cloud.langfuse.com,
# Japan=https://jp.cloud.langfuse.com, HIPAA=https://hipaa.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=local

# Local application storage. These values are not credentials.
INTELLIGENCE_VFS_ROOT=.data/vfs
INTELLIGENCE_CHECKPOINT_PATH=.data/checkpoints.sqlite3
INTELLIGENCE_VECTOR_PATH=.data/vector-index.json
INTELLIGENCE_OUTPUT_DIR=exports

# Chroma vector store for evidence retrieval (used by the Build/Fix report writer). Embeddings
# are computed with GOOGLE_API_KEY above by default; Chroma itself is local, no separate
# service required. Set INTELLIGENCE_EMBEDDING_PROVIDER=openai (with an OpenAI model name) to
# switch back to OpenAI embeddings.
INTELLIGENCE_CHROMA_PATH=.data/chroma
INTELLIGENCE_EMBEDDING_MODEL=gemini-embedding-2
INTELLIGENCE_EMBEDDING_PROVIDER=google_genai
# Max sources per research question shown to the report writer (full evidence is still what
# the source-verification script checks against; this only narrows the Build/Fix prompt).
INTELLIGENCE_EVIDENCE_TOP_K=6
# Distinct pages one research sub-agent keeps for its todo, counted across ALL of its searches
# (not per search). Each search only asks Tavily for the slots left. Default 5, max 10.
INTELLIGENCE_MAX_SOURCES_PER_TASK=5
MCP_SERVER_CONFIG=

# RAGAS Faithfulness judge (observability only — scores the passing report, never gates
# verification or publication; see observability/evaluation.py). Independent of the reasoning/
# standard tier models above (though it happens to default to the same provider): always
# Gemini, disabled entirely when GOOGLE_API_KEY is unset.
INTELLIGENCE_FAITHFULNESS_MODEL=gemini-3.7-flash

# Optional live Tavily MCP acceptance test. Keep the API key only in your local .env.
RUN_LIVE_MCP=0
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=

# Semantic-role model routing (drives the whole live app; see app.py::_get_role_router).
# "Reasoning Sandwich" baseline: a high-reasoning-effort model plans (scope, planner) and
# verifies (verify — the LLM acceptance-criteria check) around standard-tier implementation work
# (researcher, research_compressor, synthesizer, fixer).
#
# Google Gemini is the primary provider for both tiers; Groq is the fallback provider for both
# (only used if the Gemini call fails). Leave a *_FALLBACK_MODEL blank to run that profile with
# only its primary model.
# reasoning_effort is passed straight through to the provider SDK, so its value must be one that
# SDK accepts — "high" is the ceiling for both ChatGoogleGenerativeAI and ChatOpenAI (neither
# supports "xhigh"; that word is only our own name for this tier, not a real setting).
INTELLIGENCE_REASONING_MODEL=gemini-3.8-flash
INTELLIGENCE_REASONING_PROVIDER=google_genai
INTELLIGENCE_REASONING_KWARGS={"reasoning_effort":"high"}
INTELLIGENCE_REASONING_FALLBACK_MODEL=openai/gpt-oss-120b
INTELLIGENCE_REASONING_FALLBACK_PROVIDER=groq
INTELLIGENCE_STANDARD_MODEL=gemini-3.5-flash-lite
INTELLIGENCE_STANDARD_PROVIDER=google_genai
# Standard tier is meant to be cheap/fast, not deep reasoning, so keep effort low here.
INTELLIGENCE_STANDARD_KWARGS={"reasoning_effort":"low"}
INTELLIGENCE_STANDARD_FALLBACK_MODEL=openai/gpt-oss-20b
INTELLIGENCE_STANDARD_FALLBACK_PROVIDER=groq
